# Copy to .env and fill in real values. Never commit .env.

# Anthropic API (paid Tier on console.anthropic.com — separate from Max plan).
ANTHROPIC_API_KEY=

# DataForSEO API (login is your account email; password is the API key from API Access page, NOT your account password).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional overrides (defaults shown).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com
# DATAFORSEO_TIMEOUT_SECONDS=30
# DATAFORSEO_RETRIES=2

# Leonardo.ai (image generation) — set later when wiring image step.
# LEONARDO_API_KEY=

# CORS (comma-separated). Empty = no CORS middleware.
# CORS_ORIGINS=
